@model IEnumerable<HandMotionPlay_.net.Models.GameModel>
@{
    ViewData["Title"] = "Game Library";
}

<link rel="stylesheet" href="~/css/game-library.css" />

<div class="game-library">

    <!-- Heading -->
    <div class="page-header">
        <span class="subtitle">✨ Choose Your Exercise</span>
        <h1>Game Library</h1>
        <p>
            Select a game below to start your hand exercise session.
            Each game targets different aspects of hand mobility and coordination.
        </p>
    </div>

    <!-- Stats Row -->
    <div class="stats-row">
        <div class="stat-card">
            <h2>@ViewBag.TotalGames</h2>
            <p>Total Games</p>
        </div>
        <div class="stat-card">
            <h2>@ViewBag.ActivePlayers</h2>
            <p>Active Players</p>
        </div>
        <div class="stat-card">
            <h2>@ViewBag.SessionsToday</h2>
            <p>Sessions Today</p>
        </div>
        <div class="stat-card">
            <h2>@ViewBag.AvgImprovement%</h2>
            <p>Avg. Improvement</p>
        </div>
    </div>

    <!-- Game Cards -->
    <div class="game-cards">

        @foreach (var game in Model)
        {
            // Pick a random card style class to keep it colorful
            var cardColors = new[] { "blue", "pink", "green", "purple" };
            var cardColor = cardColors[game.Id % cardColors.Length];

            <div class="game-card @(cardColor)-card" style="display: flex; flex-direction: column;">
                <span class="badge @(game.Difficulty.ToLower())">@game.Difficulty</span>
                <h3>@game.Name</h3>
                <p>@game.Description</p>

                <div class="benefits flex-grow-1">
                    <strong>Benefits:</strong>
                    <ul>
                        @if (!string.IsNullOrEmpty(game.Benefits))
                        {
                            foreach(var benefit in game.Benefits.Split(','))
                            {
                                <li>@benefit.Trim()</li>
                            }
                        }
                    </ul>
                </div>

                <a class="play-btn @(cardColor)-btn mt-auto" asp-controller="Game" asp-action="@(game.ActionName ?? "Index")">
                    Play Now →
                </a>
            </div>
        }

    </div>

    <!-- Coming Soon -->
    <div class="coming-soon">
        <div class="icon">⭐</div>
        <h2>More Games Coming Soon</h2>
        <p>
            We are working on new exciting games including Puzzle Challenge and Finger Piano!
        </p>
    </div>

</div>