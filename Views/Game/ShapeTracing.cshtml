@{
    ViewData["Title"] = "Shape Tracing";
}

<link rel="stylesheet" href="~/css/shape-tracing.css" />

<div class="main-container">

    <!-- Back -->
    <div class="back-link">
        <a asp-controller="Game" asp-action="Game">
            ← Back to Games
        </a>
    </div>

    <!-- Header -->
    <div class="header-section">
        <h1>Shape Tracing</h1>
        <button class="loading-btn">Loading...</button>
    </div>

    <div class="content-wrapper">

        <!-- LEFT SIDE -->
        <div class="canvas-section">
            <div class="canvas-box" style="position: relative; overflow: hidden; background-color: var(--card-bg); display: flex; align-items: center; justify-content: center; width: 100%; height: 550px; border-radius: 16px; border: 1px solid var(--border-color);">
                <div class="loader" id="loadingSpinner"></div>
                <p id="loadingText" style="position: absolute; z-index: 10;">Initializing hand tracking...</p>
                
                <video id="videoRef" style="display: none;" autoPlay playsInline></video>
                <canvas id="cursorCanvasRef" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; background: var(--card-bg);"></canvas>
                <canvas id="canvasRef" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none;"></canvas>
                
                <div id="successOverlay" style="display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 50; flex-direction: column; align-items: center; justify-content: center; color: white; backdrop-filter: blur(4px);">
                    <div style="font-size: 64px; color: var(--success); margin-bottom: 1rem;">🏆</div>
                    <h2 style="font-size: 2.5rem; margin-bottom: 0.5rem; color: #fff;">Perfect!</h2>
                    <p style="font-size: 1.2rem; margin-bottom: 2rem;">You traced the <span id="overlayShapeName"></span> successfully.</p>
                    <div style="display: flex; gap: 2rem; margin-bottom: 2.5rem;">
                        <div style="text-align: center;">
                            <div id="overlayAccuracy" style="font-size: 2rem; font-weight: bold; color: var(--success);">100%</div>
                            <div style="font-size: 0.9rem; text-transform: uppercase;">Accuracy</div>
                        </div>
                        <div style="text-align: center;">
                            <div id="overlayTime" style="font-size: 2rem; font-weight: bold; color: var(--primary);">00:00</div>
                            <div style="font-size: 0.9rem; text-transform: uppercase;">Time</div>
                        </div>
                    </div>
                    <button class="next-btn" style="background: var(--primary); color: white; border: none; border-radius: 50px; padding: 1rem 3rem; font-size: 1.2rem; cursor: pointer;">Next Shape</button>
                </div>
            </div>

            <!-- How to Play -->
            <div class="how-to-play">
                <h3>How to Play</h3>
                <ul>
                    <li>Start at the green dot and follow the dashed outline</li>
                    <li>Point your index finger to trace the shape</li>
                    <li>Keep your finger close to the outline for better accuracy</li>
                    <li>Release your finger when you complete the shape</li>
                </ul>
            </div>
        </div>

        <!-- RIGHT SIDE PANEL -->
        <div class="control-panel">

            <!-- Current Shape -->
            <div class="card">
                <h4>Current Shape</h4>
                <div class="current-shape">
                    <h2>Circle</h2>
                    <span class="badge easy">Easy</span>
                </div>
            </div>

            <!-- Session Stats -->
            <div class="card">
                <h4>Session Stats</h4>
                <div class="stats-grid">
                    <div class="stat-box">
                        <span>00:00</span>
                        <p>Duration</p>
                    </div>
                    <div class="stat-box">
                        <span>0%</span>
                        <p>Accuracy</p>
                    </div>
                    <div class="stat-box">
                        <span>0</span>
                        <p>Completed</p>
                    </div>
                    <div class="stat-box">
                        <span>6</span>
                        <p>Total Shapes</p>
                    </div>
                </div>
            </div>

            <!-- All Shapes -->
            <div class="card">
                <h4>All Shapes</h4>

                <div class="shape-item active">
                    Circle <span class="badge easy">Easy</span>
                </div>

                <div class="shape-item">
                    Square <span class="badge easy">Easy</span>
                </div>

                <div class="shape-item">
                    Triangle <span class="badge easy">Easy</span>
                </div>

                <div class="shape-item">
                    Star <span class="badge medium">Medium</span>
                </div>

                <div class="shape-item">
                    Heart <span class="badge hard">Hard</span>
                </div>

                <div class="shape-item">
                    Infinity <span class="badge hard">Hard</span>
                </div>
            </div>

            <!-- Buttons -->
            <button class="reset-btn">Reset Shape</button>
            <button class="next-btn">Next Shape</button>

        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/shape-tracing.js"></script>
}