@model IEnumerable<HandMotionPlay_.net.Models.UserModel>
@{
    ViewData["Title"] = "Manage Users";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold">Manage Users</h2>
            <p class="text-muted">View and manage platform users.</p>
        </div>
        <a asp-controller="AdminDashboard" asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>
</div>

<div class="card admin-card mb-4">
    <div class="card-body">
        <table class="table admin-table table-hover mb-0">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Date Registered</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="align-middle">@user.Email</td>
                        <td class="align-middle">@user.Name</td>
                        <td class="align-middle">@user.Role</td>
                        <td class="align-middle">
                            @if(user.Status == "Active" || user.Status == "active") {
                                <span class="badge bg-success">@user.Status</span>
                            } else {
                                <span class="badge bg-danger">@user.Status</span>
                            }
                        </td>
                        <td class="align-middle">@user.CreatedAt.ToString("d")</td>
                        <td class="align-middle">
                            <form asp-action="ChangeStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                <input type="hidden" name="status" value="@((user.Status == "Active" || user.Status == "active") ? "inactive" : "active")" />
                                <button type="submit" class="btn btn-sm btn-outline-info">Toggle Status</button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning ms-2">Edit</a>
                            <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger ms-2">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No users found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
