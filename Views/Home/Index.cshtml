@{
    ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

<div class="home-page">

    <!-- ================= HERO ================= -->
    <section class="hero">

        <div class="hero">✨ AI - Powered Hand Rehabilitation</div>

        <h1>
            Play Your Way to <br />
            <span class="gradient-text">Better Hand Health</span>
        </h1>

        <p>
            Interactive games using webcam hand-tracking technology to improve
            finger flexibility, coordination, and motor skills.
        </p>

        <div class="hero-buttons">
            <a class="btn-primary" asp-controller="Game" asp-action="Game">▶ Start Playing</a>
            <a href="#how" class="btn-secondary">Learn More</a>
        </div>

        <!-- Stats -->
        <div class="hero-stats">
            <div><h3>@ViewBag.TotalUsers</h3><p>Active Users</p></div>
            <div><h3>@ViewBag.TotalGamesPlayed</h3><p>Games Played</p></div>
            <div><h3>@ViewBag.ImprovementRate%</h3><p>Improvement Rate</p></div>
            <div><h3>@ViewBag.ExerciseTypes</h3><p>Exercise Types</p></div>
        </div>

    </section>

    <!-- ================= HAND PREVIEW ================= -->
    <section class="hand-preview">
        <div class="preview-card">
            <div class="status">🟢 Hand Detected</div>
            <div class="hand-icon">✋</div>
        </div>
    </section>

    <!-- ================= GAMES ================= -->
    <section class="games-section">

        <h2>Interactive Games for <span class="gradient-text">Hand Rehabilitation</span></h2>

        <div class="game-grid">
            <div class="game-box blue">Canvas Drawing</div>
            <div class="game-box pink">Shape Tracing</div>
            <div class="game-box green">Target Shooting</div>
        </div>

    </section>

    <!-- ================= WHY CHOOSE ================= -->
    <section class="why-section">

        <h2>Why Choose HandMotion Play?</h2>

        <div class="why-grid">
            <div class="why-card">Real-time Tracking</div>
            <div class="why-card">Progress Analytics</div>
            <div class="why-card">Safe & Accessible</div>
            <div class="why-card">Instant Feedback</div>
        </div>

    </section>

    <!-- ================= HOW IT WORKS ================= -->
    <section id="how" class="how-section">

        <h2>How It Works</h2>

        <div class="steps">
            <div class="step">1. Enable Camera</div>
            <div class="step">2. Position Hand</div>
            <div class="step">3. Play & Exercise</div>
            <div class="step">4. Track Progress</div>
        </div>

    </section>

    <!-- ================= CAMERA PREVIEW ================= -->
    <section class="camera-preview">
        <div class="camera-box">
            <div class="camera-status">🟢 Ready to detect</div>
            <div class="camera-center">
                <h3>Camera Preview</h3>
                <p>Click a game to start your session</p>
            </div>
        </div>
    </section>

    <!-- ================= CTA ================= -->
    <section class="cta-section">

        <h2>Start Your Recovery Journey Today</h2>
        <p>
            Join thousands of users improving hand mobility and strength
            through engaging exercise games.
        </p>

        <div class="cta-buttons">
            <a class="btn-primary" asp-controller="Game" asp-action="Game">Get Started →</a>
            <a class="btn-secondary" asp-controller="Progress" asp-action="Progress">View Demo Progress</a>
        </div>

    </section>

</div>