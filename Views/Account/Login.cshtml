@{
    ViewData["Title"] = "Login";
    // Remove if using shared layout
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login - HandMotion Play</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background-color: #0b0f1a;
            font-family: 'Segoe UI', sans-serif;
            color: white;
        }

        .login-card {
            background: #111827;
            border-radius: 15px;
            padding: 40px;
            width: 400px;
            box-shadow: 0 0 25px rgba(0, 150, 255, 0.3);
        }

        .login-title {
            text-align: center;
            font-weight: bold;
            font-size: 28px;
            background: linear-gradient(90deg, #00c6ff, #ff00ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .form-control {
            background-color: #1f2937;
            border: none;
            color: white;
            height: 45px;
        }

            .form-control:focus {
                background-color: #1f2937;
                box-shadow: 0 0 5px #00c6ff;
                color: white;
            }

        .btn-login {
            background: linear-gradient(90deg, #00c6ff, #0072ff);
            border: none;
            height: 45px;
            font-weight: bold;
        }

            .btn-login:hover {
                opacity: 0.9;
            }

        .footer-text {
            font-size: 13px;
            color: #9ca3af;
        }

        .navbar {
            background-color: #0b0f1a;
        }

        .brand {
            font-weight: bold;
            color: #00c6ff;
        }

        .register-link {
            color: #00c6ff;
            text-decoration: none;
        }

            .register-link:hover {
                text-decoration: underline;
            }
    </style>
</head>

<body>
    <!-- Login Section -->
    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="login-card">

            <div class="login-title mb-4">Login</div>

            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <label>Email</label>
                    <input class="form-control" placeholder="Enter Your Email" />
                    <span class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label>Password</label>
                    <input type="password" class="form-control" placeholder="Enter Password" />
                    <span class="text-danger"></span>
                </div>

                <div class="mb-3 text-end">
                    <a asp-action="ForgotPassword" class="register-link">Forgot password?</a>
                </div>

                <button type="submit" class="btn btn-login w-100">
                    Login To Continue
                </button>

                <div class="text-center mt-3 footer-text">
                    Don't have an account?
                    <a asp-action="Register" class="register-link">Register</a>
                </div>
            </form>

        </div>
    </div>

</body>
</html>