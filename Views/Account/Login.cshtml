@{
    ViewData["Title"] = "Login";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card p-4" style="width: 400px; background-color: var(--card-bg); border: 1px solid var(--card-border); border-radius: 15px; box-shadow: 0 0 25px rgba(0, 136, 255, 0.1);">

        <div class="text-center mb-4" style="font-weight: bold; font-size: 28px; background: var(--gradient-main); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            Login
        </div>

        <form asp-controller="Account" asp-action="Login" method="post">
            
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold"></div>

            <div class="mb-3">
                <label style="color: var(--text-muted)">Email</label>
                <input name="Email" class="form-control" style="background-color: var(--bg-main); color: var(--text-main); border: 1px solid var(--border-color);" placeholder="Enter Your Email" required />
            </div>

            <div class="mb-3">
                <label style="color: var(--text-muted)">Password</label>
                <input type="password" name="Password" class="form-control" style="background-color: var(--bg-main); color: var(--text-main); border: 1px solid var(--border-color);" placeholder="Enter Password" required />
            </div>

            <div class="mb-3 text-end">
                <a href="#" style="color: var(--primary); font-size: 14px;">Forgot password?</a>
            </div>

            <button type="submit" class="btn w-100" style="background: var(--gradient-main); color: white; border: none; height: 45px; font-weight: bold; border-radius: 8px;">
                Login To Continue
            </button>

            <div class="text-center mt-3" style="font-size: 14px; color: var(--text-muted);">
                Don't have an account?
                <a asp-action="Register" style="color: var(--primary); text-decoration: none;">Register</a>
            </div>
        </form>

    </div>
</div>