@{
    ViewData["Title"] = "Profile";
}

<link rel="stylesheet" href="~/css/profile.css" />

<div class="profile-page">

    <!-- ================= PROFILE HEADER ================= -->
    <div class="profile-header">

        <div class="profile-left">
            <div class="avatar">
                @(string.IsNullOrEmpty(ViewBag.User.Name) ? "??" : ViewBag.User.Name.Substring(0, 1).ToUpper() + (ViewBag.User.Name.Length > 1 && ViewBag.User.Name.Contains(" ") ? ViewBag.User.Name.Split(" ")[1].Substring(0, 1).ToUpper() : ""))
                <span class="camera">📷</span>
            </div>

            <!-- VIEW MODE -->
            <div class="profile-info view-mode">
                <h2>@ViewBag.User.Name</h2>
                <p>📧 @ViewBag.User.Email &nbsp;&nbsp; 📅 Joined @ViewBag.User.CreatedAt.ToString("MMMM dd, yyyy")</p>
            </div>

            <!-- EDIT MODE -->
            <form asp-controller="Profile" asp-action="UpdateProfile" method="post" class="profile-info edit-mode" id="profileForm" style="display: flex; gap: 10px;">
                <input type="text" name="name" value="@ViewBag.User.Name" required />
                <input type="email" name="email" value="@ViewBag.User.Email" required />
            </form>
        </div>

        <div class="profile-actions view-mode">
            <button class="btn-primary" onclick="toggleEdit()">Edit Profile</button>
        </div>

        <div class="profile-actions edit-mode">
            <button type="submit" form="profileForm" class="btn-primary">Save</button>
            <button type="button" class="btn-secondary" onclick="toggleEdit()">Cancel</button>
        </div>

    </div>

    <!-- ================= ABOUT ================= -->
    <div class="about-section">

        <h2>About</h2>

        <!-- VIEW -->
        <p class="view-mode">
            Hand exercise enthusiast. Love improving hand mobility!
        </p>

        <!-- EDIT -->
        <textarea class="edit-mode">
Hand exercise enthusiast. Love improving hand mobility!
        </textarea>

    </div>

    <!-- ================= STATS ================= -->
    <div class="stats-row">

        <div class="stat-card">
            <div class="icon">🎮</div>
            <div>
                <p>Total Sessions</p>
                <h3>@ViewBag.TotalSessions</h3>
            </div>
        </div>

        <div class="stat-card">
            <div class="icon">🏆</div>
            <div>
                <p>Total Score</p>
                <h3>@ViewBag.TotalScore</h3>
            </div>
        </div>

        <div class="stat-card">
            <div class="icon">🎯</div>
            <div>
                <p>Best Session</p>
                <h3>@ViewBag.BestSession</h3>
            </div>
        </div>

        <div class="stat-card">
            <div class="icon">📈</div>
            <div>
                <p>Avg Session</p>
                <h3>@ViewBag.AvgSession</h3>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        function toggleEdit() {
            document.querySelectorAll('.view-mode').forEach(el => el.classList.toggle('hidden'));
            document.querySelectorAll('.edit-mode').forEach(el => el.classList.toggle('hidden'));
        }
    </script>
}